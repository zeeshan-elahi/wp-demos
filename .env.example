# Copy to .env and replace every CHANGE_ME. Used by docker-compose.yml and bin/setup.sh.
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME
WP_URL=http://localhost:8090
WP_ADMIN_USER=demo_admin
WP_ADMIN_PASSWORD=CHANGE_ME
WP_ADMIN_EMAIL=admin@example.test
# Your user and group IDs (run: id -u; id -g) so the Node build writes files you own.
HOST_UID=1000
HOST_GID=1000
