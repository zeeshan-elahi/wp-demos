{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1160px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "canvas", "name": "Canvas", "color": "#EEECE6" },
				{ "slug": "surface", "name": "Surface", "color": "#F6F4EF" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "ink", "name": "Ink", "color": "#1E1E1E" },
				{ "slug": "muted", "name": "Muted", "color": "#6B6A66" },
				{ "slug": "accent", "name": "Accent", "color": "#F9D57A" },
				{ "slug": "accent-strong", "name": "Accent strong", "color": "#E9A825" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1rem" },
				{ "slug": "heading", "name": "Heading", "size": "1.75rem", "fluid": { "min": "1.4rem", "max": "1.75rem" } },
				{ "slug": "display", "name": "Display", "size": "3.25rem", "fluid": { "min": "2rem", "max": "3.25rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--canvas)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)"
		},
		"spacing": {
			"blockGap": "0"
		}
	}
}
